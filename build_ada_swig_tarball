## Builds a tarball for binary install of Swig Ada version to /user/local.
#


#!/usr/bin/bash

set -e

mkdir -p ./usr/local/bin ./usr/local/include ./usr/local/share/swig/4.5.1/ada


# Copy build to install location.
#
cp ./ada-build/swig4ada ./usr/local/bin


cp ./swig.ads                    ./usr/local/include
cp ./swig-pointers.ads           ./usr/local/include
cp ./swig-guards.ads             ./usr/local/include
cp ./swig-guards.adb             ./usr/local/include
#cp ./interfaces_cpp_pointers.ads ./usr/local/include
#cp ./interfaces_cpp_pointers.adb ./usr/local/include


#mkdir -p /usr/local/share/swig/4.5.1/ada
#cp     ./Lib/ada/* ./usr/local/share/swig/4.5.1/ada
cp -fr ./Lib/*     ./usr/local/share/swig/4.5.1 
