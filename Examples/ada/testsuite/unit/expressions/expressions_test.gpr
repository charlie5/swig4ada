with
     "gmp";

project expressions_Test
--
-- A test of the evaluation of C expressions alone, against the values which a C compiler gives.
--
is
   for Source_Dirs use (".",
                        "../../runtime/support",
                        "../../../../../Source/Modules/ada",
                        "../../../../../Source/Modules/ada/ada_type");
   for Object_Dir  use "../../unit-build/expressions";
   for Exec_Dir    use "../../unit-build/expressions";
   for Main        use ("expressions_test.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-g");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lgmp", "-lstdc++");     -- The Ada model uses the GMP binding, by way of its utilities.
   end Linker;

end expressions_Test;
