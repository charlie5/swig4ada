#!/bin/bash
#
#  Regenerates the binding, builds the tester and runs it.
#  To be run from within this directory.

set -e

echo
echo "Removing the prior build."

rm -rf build
rm -f  ./tester *.ads *_wrap.c *_wrap.cxx *.o *.ali


echo
echo "Generating the binding."

../../../ada-build/swig4ada  -ada  char_constant.i


echo
echo "Pretty printing."

gnatpp  -rnb  -I../../..  *.ads


echo
echo "Compiling."

gprbuild  -q  -p  -P test_example.gpr


echo
echo "Running the tester."

./tester
