#!/bin/bash

clear

echo
echo removing prior build

rm -f ./tester
rm *.o
rm *.ali
rm *.a
rm *.ads



echo
echo generating bindings

../../../ada-build/swig4ada  -ada   example.i


echo
echo pretty printing ...

gnatpp  -rnb  -I../../..  *.ads


echo
echo compiling

gprbuild  -P   test_example.gpr 



echo
echo running tester ...

./tester


echo
echo cleaning up

rm *.a
rm *.o
rm *.d
rm *.ali
rm *.stderr
rm *.stdout
rm *.bexch
rm *.deps
rm b__*



gnatpp  -rnb  -I../../..  *.ads


echo
echo Done.